# Absolute paths only. This file is read by systemd, not a shell.
BRIDGE_PYTHON=/usr/bin/python3
BRIDGE_NODE=/absolute/path/to/node
BRIDGE_ROOT=/absolute/persistent/path/codex-feishu-bridge
BRIDGE_CONFIG=/absolute/persistent/path/codex-feishu-bridge/config.local.json
BRIDGE_STATE_DIR=/absolute/local/path/codex-feishu-bridge-state/supervisor
BRIDGE_LOG_DIR=/absolute/local/path/codex-feishu-bridge-state/logs
# Explicitly set the remote account's persisted Codex home and CLI PATH if needed.
# CODEX_HOME=/absolute/persistent/path/.codex
# PATH=/absolute/path/to/node/bin:/usr/local/bin:/usr/bin:/bin
